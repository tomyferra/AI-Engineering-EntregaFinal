# Copiar a .env y completar las claves (./run.sh lo crea si no existe). Nunca subir .env al repo.

# --- LLM de todos los agentes: "openai" | "anthropic" | "gemini" | "openrouter" ---
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-3.5-flash-lite"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
# Tope de tokens de salida por llamada
LLM_MAX_TOKENS="2048"
# Tope de requests/minuto al LLM, compartido por todos los jobs (14 para el free tier de Gemini). Vacío = sin límite.
LLM_REQUESTS_PER_MINUTE="14"
LLM_TIMEOUT_SECONDS="60"
LLM_MAX_RETRIES="2"

# --- RAG: "pinecone" (producción) | "memory" (mismos embeddings, sin Pinecone) | "none" (solo BM25) ---
VECTOR_STORE="pinecone"
# Embeddings: "gemini" (usa GEMINI_API_KEY) | "openai" (usa OPENAI_API_KEY)
EMBEDDING_PROVIDER="gemini"
EMBEDDING_MODEL="models/gemini-embedding-001"
EMBEDDING_DIMENSION="1536"
PINECONE_API_KEY=""
# Si el índice no existe se crea (serverless). Si existe, tiene que ser de dimensión EMBEDDING_DIMENSION.
PINECONE_INDEX_NAME="genpet-intelligence"
PINECONE_NAMESPACE="genpet-docs"
PINECONE_CLOUD="aws"
PINECONE_REGION="us-east-1"
# Pesos de la fusión RRF (calibrados con python -m scripts.evaluate_rag)
RAG_BM25_WEIGHT="0.2"
RAG_VECTOR_WEIGHT="0.8"
# Re-ranking hospedado en Pinecone después de la fusión (ej. "bge-reranker-v2-m3"). Vacío = sin re-ranking:
# en este corpus el reranker empeoró el MRR (ver README §6), por eso está apagado por defecto.
RERANK_MODEL=""
# El worker ingesta el corpus al arrancar si el namespace no lo tiene (idempotente).
RAG_AUTO_INGEST="true"

# --- Opcional: búsqueda web para el investigador (sin esta key usa solo la base de conocimiento) ---
TAVILY_API_KEY=""

# --- Redis Stack: jobs, cola, conversaciones y checkpoints de LangGraph ---
REDIS_URL="redis://localhost:6379/0"

# --- Worker ---
# true: el worker corre dentro del proceso de la API. false: aparte con `python -m app.worker` (así en Docker).
RUN_WORKER_IN_API="true"
WORKER_CONCURRENCY="5"
# Tiempo máximo por ejecución del grafo; al superarlo el job pasa a FAILED
JOB_TIMEOUT_SECONDS="600"

# --- Observabilidad: Arize Phoenix (UI en http://localhost:6006) ---
PHOENIX_ENABLED="true"
PHOENIX_COLLECTOR_ENDPOINT="http://localhost:6006"
PHOENIX_PROJECT_NAME="genpet-intelligence"
